# =============================================================================
# LLM 스택 설정 (docker compose -f docker/compose.llm.yaml 의 llm-control)
# 변경 후: docker compose -f docker/compose.llm.yaml up --build llm-control
#
# llm-control 은 docker/llm-control/llm_app_settings.json 도 읽습니다.
# 우선순위: 환경 변수 → JSON 최상단 → model 블록 → 기본값.
# =============================================================================

# 백엔드: ollama | huggingface (별칭 hf)
# LLM_PROVIDER=ollama

# --- Ollama ---
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_MODEL=medgemma:4b
# pull: docker compose -f docker/compose.llm.yaml exec ollama ollama pull medgemma:4b

# --- Hugging Face (원격 라우터 또는 로컬 TGI/vLLM 등 동일 엔드포인트) ---
LLM_PROVIDER=huggingface
# 원격 라우터(기본값과 동일할 때 생략 가능):
# HF_API_BASE=https://router.huggingface.co/v1
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-3B-Instruct:hf-inference
# Hub 토큰은 호스트에서만: export HF_TOKEN=hf_...
# 로컬 추론: compose 안의 vllm 서비스 사용
HF_API_BASE=http://vllm:8000/v1
# 호스트에서 vLLM을 따로 띄운 경우는 아래처럼 사용
# HF_API_BASE=http://host.docker.internal:8000/v1
HUGGINGFACE_MODEL=LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct
# vLLM 예시 스크립트: docker/scripts/run-vllm-local.sh (기본 포트 8000 → HF_API_BASE ...:8000/v1)

# LLM_TEMPERATURE=0.2
LLM_DUMMY=0
LLM_CONTROL_PORT=8080
