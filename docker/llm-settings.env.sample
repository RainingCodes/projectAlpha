# UMDL benchmark/runtime defaults. Real tokens must stay outside the repository.
LLM_PROVIDER=huggingface
HF_API_BASE=http://vllm:8000/v1
# docker-compose.v100.yml overrides HUGGINGFACE_MODEL with VLLM_MODEL so both services stay aligned.
HUGGINGFACE_MODEL=LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=64
LLM_HTTP_TIMEOUT=60
LLM_DUMMY=0
LLM_CONTROL_PORT=8080

# Compact UMDL IR v0.2
UMDL_MAX_TOKENS=512
UMDL_GUIDED_JSON=0
UMDL_GUIDED_BACKEND=outlines
# Baseline benchmark defaults: do not let keyword routing or few-shot hide model quality.
UMDL_FEW_SHOT=0
UMDL_FAMILY_HINTS=0
UMDL_MAX_RETRIES=0
UMDL_DATASET_ROOT=/app/dataset
UMDL_SCHEMA_PATH=/app/dataset/schema/umdl-0.1.schema.json
UMDL_GENERATION_SCHEMA_PATH=/app/dataset/schema/umdl-generation-0.2.schema.json
# Runtime emergency path stays enabled; benchmark_umdl.py sends force_llm=true.
UMDL_SAFETY_FAST_PATH=1

# Old natural-language -> Twist endpoint is disabled by default.
LEGACY_DIRECT_CONTROL_ENABLED=0
