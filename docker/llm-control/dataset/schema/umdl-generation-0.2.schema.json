{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UMDL compact generation IR 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "priority",
    "decision",
    "required_capabilities",
    "preferred_sensor_roles",
    "tasks",
    "constraints_policy",
    "contingency_policy",
    "requires_clarification",
    "missing_fields",
    "safe_fallback",
    "reason_code"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "NAVIGATION",
        "AREA_SURVEY",
        "TARGET_SEARCH",
        "SEARCH_AND_RESCUE",
        "TARGET_INSPECTION",
        "PIPELINE_INSPECTION",
        "ENVIRONMENT_MONITORING",
        "STATION_KEEPING",
        "RETURN_TO_HOME",
        "EMERGENCY_RESPONSE",
        "MISSION_ABORT",
        "UNSPECIFIED",
        "UNSUPPORTED_OPERATION"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "EXECUTE",
        "REQUEST_CLARIFICATION",
        "REJECT",
        "UNSUPPORTED"
      ]
    },
    "required_capabilities": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "WAYPOINT_NAVIGATION",
          "DEPTH_CONTROL",
          "STATION_KEEPING",
          "OBSTACLE_AVOIDANCE",
          "RETURN_NAVIGATION",
          "TARGET_DETECTION",
          "AREA_COVERAGE",
          "STRUCTURE_INSPECTION",
          "PIPELINE_FOLLOWING",
          "ENVIRONMENT_SAMPLING",
          "DATA_LOGGING",
          "SURFACE_COMMUNICATION"
        ]
      }
    },
    "preferred_sensor_roles": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Z0-9_]+$"
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target_type",
          "target_reference",
          "pattern_type",
          "pattern_parameters",
          "parameters",
          "completion_condition",
          "report_type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NAVIGATE",
              "SEARCH",
              "SURVEY",
              "INSPECT",
              "TRACK_TARGET",
              "HOLD_POSITION",
              "CHANGE_DEPTH",
              "SURFACE",
              "RETURN_HOME",
              "SAMPLE",
              "REPORT",
              "WAIT",
              "ABORT",
              "AVOID_OBSTACLE"
            ]
          },
          "target_type": {
            "type": "string",
            "enum": [
              "NONE",
              "POINT",
              "RELATIVE_POINT",
              "REGION",
              "ROUTE",
              "OBJECT",
              "OBJECT_PART",
              "OBJECT_CLASS",
              "HOME",
              "SURFACE",
              "CURRENT_POSITION",
              "CURRENT_MISSION",
              "DETECTED_OBSTACLE"
            ]
          },
          "target_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "pattern_type": {
            "type": "string",
            "enum": [
              "NONE",
              "DIRECT",
              "WAYPOINT_SEQUENCE",
              "LINE_FOLLOWING",
              "LAWNMOWER",
              "SPIRAL",
              "CIRCLE",
              "POLYGON",
              "PERIMETER_FOLLOWING",
              "PRIORITY_REGION_SEARCH"
            ]
          },
          "pattern_parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "spacing_m": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "target_depth_m": {
                "type": "number"
              },
              "duration_s": {
                "type": "integer",
                "minimum": 0
              },
              "metric": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "bearing_deg": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              "distance_m": {
                "type": "number",
                "minimum": 0
              },
              "inspection_focus": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "direction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "completion_condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "report_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          }
        }
      }
    },
    "constraints_policy": {
      "type": "string",
      "enum": [
        "PLATFORM_DEFAULT",
        "SAFE_RETURN_PROFILE"
      ]
    },
    "contingency_policy": {
      "type": "string",
      "enum": [
        "NONE",
        "BATTERY_BELOW_RESERVE_RETURN_SURFACE",
        "NAVIGATION_UNSTABLE_REPORT_SURFACE"
      ]
    },
    "requires_clarification": {
      "type": "boolean"
    },
    "missing_fields": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48,
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "safe_fallback": {
      "type": "string",
      "enum": [
        "NONE",
        "HOLD_POSITION",
        "STOP_AND_HOLD",
        "RETURN_HOME",
        "SURFACE",
        "EMERGENCY_SURFACE",
        "ABORT_MISSION"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Z0-9_]+$"
    }
  }
}
