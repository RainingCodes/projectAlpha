# Copy to docker/.env and edit as needed.

# Phase 1 fair-latency / Phase 2 primary model
VLLM_MODEL=LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct
VLLM_GPU_ID=0
VLLM_GPU_MEMORY_UTILIZATION=0.60

# Short UMDL prompts do not need the model's full maximum context window.
# Keeping this bounded reduces unnecessary KV-cache reservation/startup pressure.
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=16

# Phase 1 optional dual-GPU model B (Stonefish must be OFF)
VLLM_MODEL_B=Qwen/Qwen2.5-3B-Instruct
VLLM_GPU_ID_B=1
VLLM_GPU_MEMORY_UTILIZATION_B=0.90

# Phase 2 Stonefish uses GPU 1 after the dual benchmark services are stopped.
STONEFISH_GPU_ID=1

OLLAMA_GPU_ID=0

# XRDP example
DISPLAY=:10
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
